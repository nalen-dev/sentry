{
    admin off
}

# Production domain with automated Let's Encrypt / ZeroSSL TLS certificates
sentrydashboard.com, www.sentrydashboard.com {
    encode gzip zstd

    # REST API -> backend Rust Axum container
    handle /api/* {
        reverse_proxy api:8080
    }

    # SCADA web app (React SPA): /main (launcher), /menu, dan /app/*
    @spa path /main /main/* /menu /menu/* /app /app/* /assets/* /vite.svg
    handle @spa {
        root * /srv/app
        try_files {path} /index.html
        file_server
    }

    # Marketing site (Astro static): /, /docs, /login
    handle {
        root * /srv/site
        try_files {path} {path}.html {path}/index.html
        file_server
    }
}
