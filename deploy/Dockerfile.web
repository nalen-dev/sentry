# Multi-stage Dockerfile for SENTRY Web & Caddy
# Stage 1: Build Astro static marketing & doc site
FROM node:20-alpine AS build-site
WORKDIR /build/site
COPY site/package*.json ./
RUN npm ci
COPY site/ ./
RUN npm run build

# Stage 2: Build Vite React SCADA application (Web target)
FROM node:20-alpine AS build-app
WORKDIR /build/app
ENV VITE_TARGET=web
ENV VITE_API_BASE=/api/v1
COPY app/package*.json ./
RUN npm ci
COPY app/ ./
RUN npm run build:web

# Stage 3: Production Caddy server with auto-HTTPS and static files
FROM caddy:2-alpine
COPY --from=build-site /build/site/dist /srv/site
COPY --from=build-app /build/app/dist-web /srv/app
COPY deploy/Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443
